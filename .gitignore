# Ignore bundler config
/.bundle

# Ignore log files and temp files.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore database config, credentials, secrets (se estiver usando)
/config/database.yml
/config/master.key
/config/credentials.yml.enc

# Ignore pid files, byebug files, and cache
/tmp/pids/*
/tmp/cache/*
/tmp/sockets/*
.byebug_history

# Ignore local env files
.env
.env.*.local

# Ignore Rails assets
/public/assets
/public/packs
/public/packs-test
/node_modules
/yarn-error.log

# Ignore Byebug command history
.byebug_history

# Ignore system files
.DS_Store
Thumbs.db

# Ignore coverage reports (ex: SimpleCov)
/coverage

# Ignore editor files
*.swp
*.swo
.idea/
.vscode/
*.iml

# Ignore test files generated by Spring
.spring

# Ignore test result files
/test/tmp
/test/version_tmp

# Ignore logs from CI
/coverage
